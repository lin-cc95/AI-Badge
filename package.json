{
  "name": "ai-badge",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm --filter @ai-badge/api build && pnpm --filter @ai-badge/worker build && pnpm --filter @ai-badge/virtual-device build",
    "test": "pnpm --filter @ai-badge/api test",
    "lint": "pnpm --filter @ai-badge/api lint",
    "test:e2e": "pnpm --filter @ai-badge/api test:e2e",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "dev:api": "pnpm --filter @ai-badge/api start:dev",
    "dev:device": "pnpm --filter @ai-badge/virtual-device dev"
  }
}
